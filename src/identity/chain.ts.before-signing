/**
 * Chain Abstraction Layer
 *
 * Supports EVM, Solana and Bitcoin identities.
 *
 * The automaton selects its chain at genesis/setup time and keeps
 * that identity for its lifetime.
 */

import type { PrivateKeyAccount } from "viem";
import nacl from "tweetnacl";
import bs58 from "bs58";
import * as bitcoin from "bitcoinjs-lib";

// ─── Chain Type ──────────────────────────────────────────────

export type ChainType = "evm" | "solana" | "bitcoin";

// ─── Address Validation ──────────────────────────────────────

export function isValidEvmAddress(address: string): boolean {
  return /^0x[a-fA-F0-9]{40}$/.test(address);
}

export function isValidSolanaAddress(address: string): boolean {
  try {
    return bs58.decode(address).length === 32;
  } catch {
    return false;
  }
}

/**
 * Validate a Bitcoin mainnet address.
 *
 * Supports:
 * - Legacy P2PKH: 1...
 * - Legacy P2SH: 3...
 * - Native SegWit: bc1q...
 * - Taproot: bc1p...
 */
export function isValidBitcoinAddress(address: string): boolean {
  try {
    const decoded = bitcoin.address.fromBech32(address);

    // Bitcoin mainnet Bech32/Bech32m addresses use HRP "bc".
    if (decoded.prefix === "bc") {
      return true;
    }
  } catch {
    // Not a Bech32/Bech32m address. Continue with Base58.
  }

  try {
    const decoded = bitcoin.address.fromBase58Check(address);

    // Bitcoin mainnet:
    // 0x00 = P2PKH (1...)
    // 0x05 = P2SH  (3...)
    return decoded.version === 0x00 || decoded.version === 0x05;
  } catch {
    return false;
  }
}

export function isValidAddress(
  address: string,
  chainType?: ChainType,
): boolean {
  if (chainType === "evm") {
    return isValidEvmAddress(address);
  }

  if (chainType === "solana") {
    return isValidSolanaAddress(address);
  }

  if (chainType === "bitcoin") {
    return isValidBitcoinAddress(address);
  }

  return (
    isValidEvmAddress(address) ||
    isValidSolanaAddress(address) ||
    isValidBitcoinAddress(address)
  );
}

export function detectChainType(address: string): ChainType | null {
  if (isValidEvmAddress(address)) {
    return "evm";
  }

  if (isValidSolanaAddress(address)) {
    return "solana";
  }

  if (isValidBitcoinAddress(address)) {
    return "bitcoin";
  }

  return null;
}

export function normalizeAddress(
  address: string,
  chain: ChainType,
): string {
  // EVM addresses are normalized to lowercase.
  // Solana and Bitcoin addresses are preserved.
  return chain === "evm" ? address.toLowerCase() : address;
}

// ─── Chain Identity Interface ────────────────────────────────

/**
 * Chain-agnostic identity interface.
 *
 * EVM:
 *   viem PrivateKeyAccount
 *
 * Solana:
 *   Ed25519 keypair
 *
 * Bitcoin:
 *   Bitcoin address identity.
 *
 * Bitcoin signing is intentionally not implemented here yet.
 * It will be added in the wallet/payment layer.
 */
export interface ChainIdentity {
  readonly chainType: ChainType;
  readonly address: string;
  signMessage(message: string): Promise<string>;
}

// ─── EVM Chain Identity ──────────────────────────────────────

export class EvmChainIdentity implements ChainIdentity {
  readonly chainType: ChainType = "evm";
  readonly address: string;
  readonly account: PrivateKeyAccount;

  constructor(account: PrivateKeyAccount) {
    this.account = account;
    this.address = account.address;
  }

  async signMessage(message: string): Promise<string> {
    return this.account.signMessage({ message });
  }
}

// ─── Solana Chain Identity ───────────────────────────────────

export class SolanaChainIdentity implements ChainIdentity {
  readonly chainType: ChainType = "solana";
  readonly address: string;

  private readonly keypair: nacl.SignKeyPair;

  constructor(secretKey: Uint8Array) {
    this.keypair = nacl.sign.keyPair.fromSecretKey(secretKey);
    this.address = bs58.encode(this.keypair.publicKey);
  }

  async signMessage(message: string): Promise<string> {
    const messageBytes = new TextEncoder().encode(message);
    const signature = nacl.sign.detached(
      messageBytes,
      this.keypair.secretKey,
    );

    return bs58.encode(signature);
  }

  getSecretKey(): Uint8Array {
    return this.keypair.secretKey;
  }

  getPublicKey(): Uint8Array {
    return this.keypair.publicKey;
  }
}

// ─── Bitcoin Chain Identity ──────────────────────────────────

/**
 * Bitcoin identity based on a public address.
 *
 * This is deliberately separated from private-key handling.
 * The Bitcoin signing/wallet implementation will be added later.
 */
export class BitcoinChainIdentity implements ChainIdentity {
  readonly chainType: ChainType = "bitcoin";
  readonly address: string;

  constructor(address: string) {
    if (!isValidBitcoinAddress(address)) {
      throw new Error(`Invalid Bitcoin address: ${address}`);
    }

    this.address = address;
  }

  /**
   * Bitcoin message signing is not implemented yet.
   *
   * We fail explicitly instead of pretending that an address-only
   * identity can sign Bitcoin transactions.
   */
  async signMessage(_message: string): Promise<string> {
    throw new Error(
      "Bitcoin message signing is not implemented yet. " +
      "Use the Bitcoin wallet/signing layer.",
    );
  }
}
